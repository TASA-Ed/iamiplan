fn age(uiid)
sj(sss.language,"&lt;"+uiid+"&gt;","&lt;/"+uiid+"&gt;",ghila)
sl(ghila,"\n",lang)
for(data;lang)
{
  sj(data,"[","]",dct)
  sl(dct,".",dl)
  sgsz(dl,0,uid)
  f(uid==uiid)
  {
    sgsz(dl,1,kid)
    sgsz(dl,2,type)
    sj(data,"=",null,txt)
    us(kid,type,txt)
  }
}
end fn
fn chdh(uiid)
sj(sss.language,"&lt;"+uiid+"&gt;","&lt;/"+uiid+"&gt;",ghila)
sl(ghila,"\n",lang)
for(data;lang)
{
  sj(data,"[","]",dct)
  sl(dct,".",dl)
  sgsz(dl,0,uid)
  f(uid==uiid)
  {
    sgsz(dl,1,kid)
    sgsz(dl,2,type)
    sj(data,"=",null,txt)
    us(uiid+"."+kid,type,txt)
  }
}
end fn
fn code(codeid)
sj(sss.language,"&lt;code&gt;","&lt;/code&gt;",ghila)
sl(ghila,"\n",lang)
for(data;lang)
{
  sj(data,"[","]",dct)
  sl(dct,".",dl)
  sgsz(dl,0,uid)
  f(uid=="code")
  {
    sgsz(dl,1,uid)
    f(uid==codeid)
    {
      sj(data,"=",null,sss.vtext)
    }
  }
}
end fn