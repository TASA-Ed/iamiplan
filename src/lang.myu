fn age(uiid)
// 控件本地化
sj(sss.language,"&lt;"+uiid+"&gt;","&lt;/"+uiid+"&gt;",ghila)
sl(ghila,"\n",lang)
for(data;lang)
{
  sj(data,"[","]",dct)
  sl(dct,".",dl)
  sgsz(dl,0,uid)
  f(uid==uiid)
  {
    sgsz(dl,1,kid)
    sgsz(dl,2,type)
    sj(data,"=",null,txt)
    us(kid,type,txt)
  }
}
end fn
fn chdh(uiid)
// 滑动窗体本地化
sj(sss.language,"&lt;"+uiid+"&gt;","&lt;/"+uiid+"&gt;",ghila)
sl(ghila,"\n",lang)
for(data;lang)
{
  sj(data,"[","]",dct)
  sl(dct,".",dl)
  sgsz(dl,0,uid)
  f(uid==uiid)
  {
    sgsz(dl,1,kid)
    sgsz(dl,2,type)
    sj(data,"=",null,txt)
    us(uiid+"."+kid,type,txt)
  }
}
end fn
fn code(codeid)
// 代码本地化
sj(sss.language,"&lt;code&gt;","&lt;/code&gt;",ghila)
sl(ghila,"\n",lang)
for(data;lang)
{
  sj(data,"[","]",dct)
  sl(dct,".",dl)
  sgsz(dl,0,uid)
  f(uid=="code")
  {
    sgsz(dl,1,uid)
    f(uid==codeid)
    {
      sj(data,"=",null,sss.vtext)
    }
  }
}
end fn
fn readInfo(languageName)
// 读取语言信息
fr("@languages/"+languageName+".ule3",lang)
sj(lang,"&lt;?User-interface-LanguagE-files-v3.0&gt;","&lt;/?&gt;",langInfo)
sj(langInfo,"[language.name]=","\n",sss.langName)
sj(langInfo,"[language.author]=","\n",sss.langAuthor)
end fn