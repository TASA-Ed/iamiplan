fn reload()
ula(sss.db,"clear")
//清空
json(sss.tojson,"get","idlist",idlist)
sl(idlist,"\,",idsl)
//读取ID列表
for(uid;idsl)
{
	f(uid==0 || uid=="NaN")
	{
	}
	//忽略ID 0和NaN
	else
	{
		fe("$todo/uuid"+uid+".json",uife)
		f(uife==true)
		{
			fr("$todo/uuid"+uid+".json",uidc)
			json(uidc,uujs)
			json(uujs,"get","content",cont)
			json(uujs,"get","name",name)
            // 反转义特殊字符
            sr(name,"\\\"","\"",name)
            sr(cont,"\\\"","\"",cont)
			json(uujs,"get","settime",st)
			json(uujs,"get","createtime",ct)
			//读取数据
			ula(sss.db,笔记.5="笔记列表",10=name,11=st,-1=ct,-2=uid)
		}
        else
        {
        	// 清除无效 ID
        	sr(idlist,uid+"\,","",idlist)
        	json(sss.tojson,"set","idlist",idlist)
            json(sss.tojson,"json",jso)
            fw("$todo/todolist.json",jso)
        }
	}
	
}
end fn

fn rdvalue(vnamec)
//读取value.prop
sj(sss.value,vnamec+"#=","\n",vusl)
f(vusl?"loadfile:")
{
	sj(vusl,"loadfile:",null,ume)
	fr(ume,vusl)
}
sss vals=vusl
end fn

fn uuid()
//uuid生成
time(4,vatime)
sran(2,268435456,vagf)
sran(2,4096,va1)
s((vatime + vagf) / va1,vagf)
sran(2,128,va2)
s(vagf * va2,vagf)
sss urid=vagf
end fn

fn uuidfor32()
//给32位手机提供的UUID生成
sran(1,2147483647,vahg)
sss urid32=vahg
end fn

