ulag(st_vW,7,langName)
fn lang.code("setlang")
sr(sss.vtext,"{name}",langName,keysetlang)
fn lang.code("tit1")
s keytit1=sss.vtext
fn lang.code("v3")
s keyv3=sss.vtext
fn lang.code("v4")
s keyv4=sss.vtext
utw("@img/translate.png",keytit1,keysetlang,keyv3,keyv4,false,v)
{
	fr("@languages/"+langFileName+".ule3",sss.language)
    fn lang.code("tw2")
    tw(sss.vtext)
    fw("$todo/lang",langFileName)
    end()
    endcode
}
else
{
	
}</eventItme></event>
