orientation=horizontal
gravity=center_vertical
layout_weight=1</ppt>
<event><eventItme type="clicki">fn lang.code("tit1")
s tit=sss.vtext
fn lang.code("v3")
s ch1=sss.vtext
fn lang.code("v4")
s ch2=sss.vtext
utw("@img/translate.png",tit,"语言列表.iyu",ch1,ch2,false,v)
{
  gvs(v,2,vs)
  ug(vs,"text",g)
  ss(g+".ule3",gvn)
  fe("@langages/"+gvn,uvs)
  f(uvs==true)
  {
    fw("$todo/lang",g)
    fn lang.code("tw2")
    tw(sss.vtext)
  }
  else
  {
    fn lang.code("tw3")
    tw(sss.vtext)
  }
}
else
{
}</eventItme></event>
</View>
